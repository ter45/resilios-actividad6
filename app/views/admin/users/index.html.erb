<div class="flex flex-wrap items-center justify-between mb-6 gap-4">
  <div>
    <h2 class="text-2xl font-bold text-gray-900">Usuarios</h2>
    <p class="text-sm text-gray-500 mt-1">Administra las cuentas y el acceso al minimercado.</p>
  </div>
  <%= link_to "+ Nuevo usuario", new_admin_user_path, class: "px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-medium" %>
</div>
<%= form_with url: admin_users_path, method: :get, class: "bg-white rounded-lg shadow p-4 mb-4 flex gap-3 items-end flex-wrap" do %>
  <div class="flex-1 min-w-0 w-full">
    <%= label_tag :q, "Buscar por nombre o correo", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= text_field_tag :q, params[:q], class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
  </div>
  <div>
    <%= label_tag :role, "Rol", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= select_tag :role, options_for_select([["Todos", ""]] + User.roles.keys.map { |role| [user_role_label(role), role] }, params[:role]), class: "px-3 py-2 border border-gray-300 rounded-lg bg-white" %>
  </div>
  <div>
    <%= label_tag :active, "Estado", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= select_tag :active, options_for_select([["Todos", ""], ["Activos", "1"], ["Inactivos", "0"]], params[:active]), class: "px-3 py-2 border border-gray-300 rounded-lg bg-white" %>
  </div>
  <%= submit_tag "Filtrar", class: "px-4 py-2 bg-slate-700 text-white rounded-lg cursor-pointer" %>
  <%= link_to "Limpiar", admin_users_path, class: "px-4 py-2 text-gray-600" %>
<% end %>
<div class="bg-white rounded-lg shadow overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200 text-gray-500">
      <tr>
        <% ["Usuario", "Rol", "Terminal", "Estado", "Acciones"].each do |heading| %>
          <th scope="col" class="text-left px-4 py-3 font-medium"><%= heading %></th>
        <% end %>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @users.each do |user| %>
        <tr>
          <td class="px-4 py-3"><p class="font-medium text-gray-900"><%= user.name %><%= " (tú)" if user == current_user %></p><p class="text-gray-500"><%= user.email %></p></td>
          <td class="px-4 py-3"><%= user_role_label(user.role) %></td>
          <td class="px-4 py-3"><%= user.terminal_assigned.presence || "Sin asignar" %></td>
          <td class="px-4 py-3"><span class="px-2 py-1 text-xs rounded <%= user.active? ? 'bg-green-100 text-green-700' : 'bg-gray-200 text-gray-700' %>"><%= user.active? ? "Activo" : "Inactivo" %></span></td>
          <td class="px-4 py-3"><%= link_to "Editar", edit_admin_user_path(user), class: "text-emerald-700 hover:underline", aria: { label: "Editar a #{user.name}" } %></td>
        </tr>
      <% end %>
      <% if @users.empty? %>
        <tr><td colspan="5" class="p-8 text-center text-gray-500">No hay usuarios que coincidan con los filtros.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<p class="text-xs text-gray-500 mt-3">Se muestran hasta 100 usuarios. Usa los filtros para acotar la búsqueda.</p>
