<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-2xl font-bold text-gray-900">Cierres de caja</h2>
    <p class="text-sm text-gray-500 mt-1">Histórico de cierres con diferencias</p>
  </div>
</div>

<!-- Cards de resumen -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-lg shadow p-4">
    <p class="text-xs text-gray-500 uppercase">Cierres</p>
    <p class="text-2xl font-bold text-gray-900"><%= @totals[:count] %></p>
  </div>
  <div class="bg-white rounded-lg shadow p-4">
    <p class="text-xs text-gray-500 uppercase">Total esperado</p>
    <p class="text-xl font-bold text-emerald-700">$ <%= number_with_delimiter(@totals[:expected_total].to_i, delimiter: ".") %></p>
    <p class="text-xs text-gray-500 mt-1">Contado: $ <%= number_with_delimiter(@totals[:counted_total].to_i, delimiter: ".") %></p>
  </div>
  <div class="bg-white rounded-lg shadow p-4">
    <p class="text-xs text-gray-500 uppercase">Diferencia neta</p>
    <p class="text-xl font-bold <%= @totals[:difference].to_i.zero? ? 'text-gray-900' : (@totals[:difference].to_i.negative? ? 'text-red-700' : 'text-yellow-700') %>">
      <% diff = @totals[:difference].to_i %>
      <%= diff.negative? ? "-" : (diff.positive? ? "+" : "") %>$ <%= number_with_delimiter(diff.abs, delimiter: ".") %>
    </p>
  </div>
  <div class="bg-white rounded-lg shadow p-4">
    <p class="text-xs text-gray-500 uppercase">Anomalías</p>
    <p class="text-sm text-red-700">Faltantes: <strong><%= @totals[:shortage_count] %></strong></p>
    <p class="text-sm text-yellow-700">Sobrantes: <strong><%= @totals[:surplus_count] %></strong></p>
  </div>
</div>

<!-- Filtros -->
<%= form_with url: admin_cash_closings_path, method: :get, local: true, class: "bg-white rounded-lg shadow p-4 mb-4 grid grid-cols-1 md:grid-cols-5 gap-3 items-end" do %>
  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1">Fecha</label>
    <%= date_field_tag :date, @date,
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1">Terminal</label>
    <%= select_tag :terminal_id,
          options_for_select([["Todas", ""], ["A", "A"], ["B", "B"]], params[:terminal_id]),
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none bg-white" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1">Cajero</label>
    <%= select_tag :user_id,
          options_from_collection_for_select(@users, :id, :name, params[:user_id]),
          include_blank: "Todos",
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none bg-white" %>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-600 mb-1">Estado</label>
    <%= select_tag :status,
          options_for_select([["Todos", ""], ["Cuadrados", "balanced"], ["Con faltante", "shortage"], ["Con sobrante", "surplus"]], params[:status]),
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none bg-white" %>
  </div>
  <div class="flex gap-2">
    <%= submit_tag "Filtrar", class: "px-4 py-2 bg-slate-700 hover:bg-slate-800 text-white rounded-lg font-medium cursor-pointer" %>
    <%= link_to "Hoy", admin_cash_closings_path, class: "px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-medium" %>
  </div>
<% end %>

<!-- Tabla -->
<div class="bg-white rounded-lg shadow overflow-hidden">
  <% if @closings.any? %>
    <table class="w-full">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Fecha</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Terminal</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Cajero</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Periodo</th>
          <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Ventas</th>
          <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Esperado</th>
          <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Contado</th>
          <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Diferencia</th>
          <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @closings.each do |c| %>
          <tr class="<%= c.shortage? ? 'bg-red-50' : (c.surplus? ? 'bg-yellow-50' : '') %>">
            <td class="px-4 py-3 text-sm text-gray-600"><%= c.closed_at.strftime("%d/%m %H:%M") %></td>
            <td class="px-4 py-3 text-sm"><%= c.terminal_id %></td>
            <td class="px-4 py-3 text-sm"><%= c.user.display_name %></td>
            <td class="px-4 py-3 text-xs text-gray-500">
              <%= c.opened_at.strftime("%H:%M") %> → <%= c.closed_at.strftime("%H:%M") %>
              <div class="text-xs text-gray-400"><%= c.duration_minutes %> min</div>
            </td>
            <td class="px-4 py-3 text-right text-sm"><%= c.sales_count %></td>
            <td class="px-4 py-3 text-right text-sm">$ <%= number_with_delimiter(c.expected_cash.to_i, delimiter: ".") %></td>
            <td class="px-4 py-3 text-right text-sm">$ <%= number_with_delimiter(c.counted_cash.to_i, delimiter: ".") %></td>
            <td class="px-4 py-3 text-right text-sm font-bold <%= c.shortage? ? 'text-red-700' : (c.surplus? ? 'text-yellow-700' : 'text-gray-700') %>">
              <%= c.display_difference %>
            </td>
            <td class="px-4 py-3 text-right text-sm">
              <%= link_to "Ver", admin_cash_closing_path(c),
                    class: "text-xs px-3 py-1 bg-blue-100 hover:bg-blue-200 text-blue-700 rounded" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="p-12 text-center text-gray-500">
      <p>No hay cierres con los filtros seleccionados.</p>
    </div>
  <% end %>
</div>
