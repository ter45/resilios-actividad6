<div class="mb-6">
  <%= link_to "← Volver", admin_categories_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h2 class="text-2xl font-bold text-gray-900 mt-2"><%= @category.name %></h2>
</div>

<div class="bg-white rounded-lg shadow p-6 max-w-2xl space-y-3">
  <div>
    <p class="text-xs text-gray-500 uppercase">Código</p>
    <p class="font-mono"><%= @category.code || "—" %></p>
  </div>
  <div>
    <p class="text-xs text-gray-500 uppercase">Posición</p>
    <p><%= @category.position %></p>
  </div>
  <div>
    <p class="text-xs text-gray-500 uppercase">Estado</p>
    <p>
      <% if @category.discarded? %>
        <span class="px-2 py-1 text-xs bg-red-100 text-red-700 rounded">Eliminada</span>
      <% elsif @category.active? %>
        <span class="px-2 py-1 text-xs bg-green-100 text-green-700 rounded">Activa</span>
      <% else %>
        <span class="px-2 py-1 text-xs bg-gray-200 text-gray-700 rounded">Inactiva</span>
      <% end %>
    </p>
  </div>
  <% if policy(@category).update? %>
    <div class="pt-4 border-t border-gray-200">
      <%= link_to "Editar", edit_admin_category_path(@category),
            class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg" %>
    </div>
  <% end %>
</div>
