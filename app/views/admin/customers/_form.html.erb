<%= form_with(model: [:admin, customer], html: { class: "space-y-5" }) do |f| %>
  <% if customer.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-sm font-medium text-red-800 mb-2">
        <%= pluralize(customer.errors.count, "error impidió", plural: "errores impidieron") %> guardar el cliente:
      </h3>
      <ul class="list-disc list-inside text-sm text-red-700">
        <% customer.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div class="md:col-span-2">
      <%= f.label :name, "Nombre completo", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, required: true, autofocus: true,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
    </div>

    <div>
      <%= f.label :document_type, "Tipo de documento", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :document_type,
            [["Cédula de Ciudadanía", "cc"], ["NIT", "nit"], ["Cédula de Extranjería", "ce"], ["Pasaporte", "pa"], ["Tarjeta de Identidad", "ti"]],
            {},
            { class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none bg-white" } %>
    </div>

    <div>
      <%= f.label :document_number, "Número de documento", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :document_number, maxlength: 30,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
      <p class="text-xs text-gray-500 mt-1">Opcional. Sin documento no se le puede fiar.</p>
    </div>

    <div>
      <%= f.label :phone, "Teléfono", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :phone, maxlength: 30,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
    </div>

    <div>
      <%= f.label :credit_limit, "Cupo de crédito (COP)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :credit_limit, step: 1000, min: 0,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
      <p class="text-xs text-gray-500 mt-1">0 = no se le fía. Solo admin y supervisor pueden modificar.</p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :address, "Dirección", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :address, maxlength: 200,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
    </div>
  </div>

  <% if customer.persisted? && customer.credit_balance.positive? %>
    <div class="bg-orange-50 border border-orange-200 rounded-lg p-4">
      <p class="text-sm text-orange-800">
        <strong>Saldo pendiente:</strong> $<%= customer.credit_balance.to_i %>
        (<%= customer.credit_used_percent %>% del cupo)
      </p>
    </div>
  <% end %>

  <div class="flex items-center pt-4 border-t border-gray-200">
    <%= f.check_box :active, class: "h-4 w-4 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500" %>
    <%= f.label :active, "Cliente activo", class: "ml-2 text-sm text-gray-700" %>
  </div>

  <div class="flex gap-3 pt-4">
    <%= f.submit customer.persisted? ? "Guardar cambios" : "Crear cliente",
          class: "px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg transition cursor-pointer" %>
    <%= link_to "Cancelar", admin_customers_path,
          class: "px-5 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium rounded-lg transition" %>
  </div>
<% end %>
