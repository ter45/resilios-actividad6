<div class="mb-6">
  <%= link_to "← Volver", admin_customers_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h2 class="text-2xl font-bold text-gray-900 mt-2"><%= @customer.name %></h2>
  <p class="text-sm text-gray-500 mt-1"><%= @customer.display_document %></p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div class="bg-white rounded-lg shadow p-6 md:col-span-2">
    <h3 class="text-sm font-semibold text-gray-700 uppercase mb-4">Información</h3>
    <dl class="grid grid-cols-2 gap-4 text-sm">
      <div><dt class="text-xs text-gray-500 uppercase">Teléfono</dt><dd class="font-medium"><%= @customer.phone.presence || "—" %></dd></div>
      <div><dt class="text-xs text-gray-500 uppercase">Documento</dt><dd class="font-mono"><%= @customer.display_document %></dd></div>
      <div class="col-span-2"><dt class="text-xs text-gray-500 uppercase">Dirección</dt><dd><%= @customer.address.presence || "—" %></dd></div>
      <div><dt class="text-xs text-gray-500 uppercase">Estado</dt>
        <dd>
          <% if @customer.discarded? %>
            <span class="px-2 py-1 text-xs bg-red-100 text-red-700 rounded">Eliminado</span>
          <% elsif @customer.active? %>
            <span class="px-2 py-1 text-xs bg-green-100 text-green-700 rounded">Activo</span>
          <% else %>
            <span class="px-2 py-1 text-xs bg-gray-200 text-gray-700 rounded">Inactivo</span>
          <% end %>
        </dd>
      </div>
    </dl>

    <% if policy(@customer).update? %>
      <div class="mt-6 pt-4 border-t border-gray-200">
        <%= link_to "Editar", edit_admin_customer_path(@customer),
              class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-sm font-semibold text-gray-700 uppercase mb-4">Crédito</h3>
    <% if @customer.credit_limit.positive? %>
      <div class="space-y-3 text-sm">
        <div>
          <p class="text-xs text-gray-500 uppercase">Cupo total</p>
          <p class="text-lg font-medium">$ <%= @customer.credit_limit.to_i %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Saldo pendiente</p>
          <p class="text-lg font-medium <%= @customer.in_debt? ? 'text-orange-700' : 'text-green-700' %>">
            $ <%= @customer.credit_balance.to_i %>
          </p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase">Disponible</p>
          <p class="text-lg font-medium text-emerald-700">$ <%= @customer.available_credit.to_i %></p>
        </div>
        <% if @customer.credit_limit.positive? %>
          <div>
            <div class="flex justify-between text-xs text-gray-500 mb-1">
              <span>Uso del cupo</span>
              <span><%= @customer.credit_used_percent %>%</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <% pct = [@customer.credit_used_percent, 100].min %>
              <div class="<%= pct > 80 ? 'bg-red-500' : (pct > 50 ? 'bg-orange-500' : 'bg-emerald-500') %> h-2 rounded-full" style="width: <%= pct %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">Este cliente no tiene cupo de crédito.</p>
      <p class="text-xs text-gray-400 mt-1">Editá para asignarle uno.</p>
    <% end %>
  </div>
</div>
