<%= form_with(model: [:admin, product], html: { class: "space-y-5" }) do |f| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-sm font-medium text-red-800 mb-2">
        <%= pluralize(product.errors.count, "error impidió", plural: "errores impidieron") %> guardar el producto:
      </h3>
      <ul class="list-disc list-inside text-sm text-red-700">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div class="md:col-span-2">
      <%= f.label :name, "Nombre", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, required: true, autofocus: true,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
    </div>

    <div>
      <%= f.label :category_id, "Categoría", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :category_id, Category.kept.active.ordered, :id, :name,
            { include_blank: "— Seleccionar —" },
            { required: true, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none bg-white" } %>
    </div>

    <div>
      <%= f.label :pricing_mode, "Tipo de venta", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :pricing_mode,
            [["Por unidad", "unit"], ["Por peso (kg)", "weight"]],
            {},
            { class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none bg-white" } %>
    </div>

    <div>
      <%= f.label :sku, "SKU", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :sku, maxlength: 30, placeholder: "Código interno",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none font-mono uppercase" %>
      <p class="text-xs text-gray-500 mt-1">Opcional. Se convierte a mayúsculas.</p>
    </div>

    <div>
      <%= f.label :barcode, "Código de barras", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :barcode, maxlength: 30, placeholder: "EAN-13 o similar",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none font-mono" %>
      <p class="text-xs text-gray-500 mt-1">Opcional. Para escáner.</p>
    </div>

    <div>
      <%= f.label :cost, "Costo (COP)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :cost, step: 0.01, min: 0,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
    </div>

    <div>
      <%= f.label :price, "Precio venta (COP)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :price, step: 0.01, min: 0, required: true,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
    </div>

    <div>
      <%= f.label :stock, "Stock actual", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :stock, step: 0.001, min: 0,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
      <p class="text-xs text-gray-500 mt-1">Para productos pesados, en kg.</p>
    </div>

    <div>
      <%= f.label :tax_rate, "IVA (decimal)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :tax_rate, step: 0.01, min: 0, max: 0.99,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" %>
      <p class="text-xs text-gray-500 mt-1">0.19 = 19%. Productos exentos: 0.</p>
    </div>
  </div>

  <div class="flex items-center pt-4 border-t border-gray-200">
    <%= f.check_box :active, class: "h-4 w-4 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500" %>
    <%= f.label :active, "Producto activo (visible en POS)", class: "ml-2 text-sm text-gray-700" %>
  </div>

  <div class="flex gap-3 pt-4">
    <%= f.submit product.persisted? ? "Guardar cambios" : "Crear producto",
          class: "px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg transition cursor-pointer" %>
    <%= link_to "Cancelar", admin_products_path,
          class: "px-5 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium rounded-lg transition" %>
  </div>
<% end %>
