<div class="w-full max-w-md">
  <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
    <div class="bg-slate-900 px-8 py-6 text-center">
      <h1 class="text-2xl font-bold text-white">ResiliOS POS</h1>
      <p class="text-slate-400 text-sm mt-1">Minimercado · Iniciar sesión</p>
    </div>

    <div class="p-8">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <div>
          <%= f.label :email, "Correo electrónico", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                placeholder: "tu@correo.com",
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition" %>
        </div>

        <div>
          <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password,
                autocomplete: "current-password",
                placeholder: "••••••••",
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500" %>
            <%= f.label :remember_me, "Recordarme en este equipo", class: "ml-2 text-sm text-gray-600" %>
          </div>
        <% end %>

        <%= f.submit "Iniciar sesión",
              class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 rounded-lg transition shadow-md cursor-pointer" %>
      <% end %>

      <div class="mt-6 pt-6 border-t border-gray-200 text-xs text-gray-500 text-center">
        Sistema POS Edge · v0.1
      </div>
    </div>
  </div>
</div>
