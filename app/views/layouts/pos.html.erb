<!DOCTYPE html>
<html lang="es">
  <head>
    <title>ResiliOS POS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-emerald-900 text-white">
    <% if alert %>
      <div class="bg-red-600 px-4 py-2 text-center"><%= alert %></div>
    <% end %>
    <%= yield %>
  </body>
</html>
