<div class="h-screen flex flex-col bg-slate-900 text-white"
     data-controller="cart search scale"
     data-cart-cart-id-value="<%= @cart_id %>"
     data-cart-terminal-id-value="<%= @terminal_id %>"
     data-cart-print-bridge-url-value="http://127.0.0.1:8088"
     data-scale-bridge-url-value="http://127.0.0.1:8088"
     <% if @resume_payload.present? %>
       data-cart-resume-payload-value="<%= json_escape(@resume_payload.to_json) %>"
     <% end %>>

  <!-- Header -->
  <header class="bg-slate-800 px-6 py-3 flex items-center justify-between border-b border-slate-700">
    <div class="flex items-center gap-4">
      <h1 class="text-lg font-bold">ResiliOS POS</h1>
      <span class="text-xs px-2 py-1 bg-emerald-700 rounded">Terminal <%= @terminal_id %></span>
      <span class="text-xs text-slate-400"><%= current_user.display_name %></span>
    </div>
    <div class="flex items-center gap-4">
      <%= link_to suspended_pos_sales_path, class: "text-xs text-purple-400 hover:text-purple-300 flex items-center gap-1" do %>
        Suspendidas
        <% if @suspended_count.to_i > 0 %>
          <span class="inline-block px-2 py-0.5 bg-purple-600 text-white rounded-full text-xs font-bold"><%= @suspended_count %></span>
        <% end %>
      <% end %>
      <%= link_to "Cobrar abonos", pos_credits_path, class: "text-xs text-blue-400 hover:text-blue-300" %>
      <%= link_to "Cerrar caja", new_pos_closing_path, class: "text-xs text-amber-400 hover:text-amber-300" %>
      <%= button_to "Cerrar sesión", destroy_user_session_path,
          method: :delete,
          class: "text-xs text-red-400 hover:text-red-300" %>
    </div>
  </header>

  <div class="flex-1 grid grid-cols-12 overflow-hidden">

    <section class="col-span-5 bg-slate-800 flex flex-col overflow-hidden border-r border-slate-700">
      <div class="p-3 border-b border-slate-700">
        <input type="text"
               data-search-target="input"
               aria-label="Buscar producto por nombre, SKU o código de barras"
               data-action="input->search#perform keydown.enter->search#scan"
               placeholder="Buscar producto, SKU o escanear codigo de barras..."
               class="w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-base focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none"
               autofocus>

        <div class="mt-3 rounded-lg border border-slate-700 bg-slate-900 p-3">
          <div class="flex items-center justify-between gap-3">
            <div>
              <div class="text-xs uppercase tracking-wide text-slate-500">Balanza ACS-30</div>
              <div data-scale-target="weight" class="text-2xl font-bold text-emerald-400">0.000 kg</div>
              <div data-scale-target="status" class="text-xs text-slate-400">Desconectada</div>
            </div>
            <button type="button"
                    data-scale-target="connectButton"
                    data-action="click->scale#connectScale"
                    class="px-3 py-2 rounded bg-emerald-600 hover:bg-emerald-700 text-xs font-bold">
              Conectar
            </button>
          </div>
          <div class="mt-3 flex gap-2">
            <input type="number"
                   min="0"
                   step="0.01"
                   inputmode="decimal"
                   data-scale-target="manualWeight"
                   placeholder="Peso manual kg"
                   class="min-w-0 flex-1 px-3 py-2 bg-slate-800 border border-slate-600 rounded text-sm outline-none focus:ring-2 focus:ring-emerald-500">
            <button type="button"
                    data-action="click->scale#useManualWeight"
                    class="px-3 py-2 rounded bg-slate-700 hover:bg-slate-600 text-xs font-bold">
              Usar
            </button>
          </div>
          <p class="mt-2 text-[11px] text-slate-500">
            Para productos por peso, conecta el adaptador USB/CH340 o ingresa el peso y selecciona el producto.
          </p>
        </div>

        <div class="flex gap-2 mt-3 flex-wrap">
          <button data-action="click->search#filterCategory"
                  data-category-id=""
                  class="px-3 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs">Todos</button>
          <% @categories.each do |cat| %>
            <button data-action="click->search#filterCategory"
                    data-category-id="<%= cat.id %>"
                    class="px-3 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs">
              <%= cat.name %>
            </button>
          <% end %>
        </div>
      </div>

      <div class="px-3 py-2 text-xs text-slate-300" data-search-target="status" role="status" aria-live="polite"></div>
      <div data-search-target="results"
           class="flex-1 overflow-y-auto p-3 grid grid-cols-2 gap-2 content-start">
        <div class="col-span-2 text-center text-slate-500 py-8">
          Comenza a buscar productos o selecciona una categoria
        </div>
      </div>
      <nav aria-label="Páginas del catálogo" class="flex items-center justify-between p-3 border-t border-slate-700">
        <button type="button" data-search-target="previous" data-action="search#previousPage" disabled class="px-3 py-2 bg-slate-700 rounded disabled:opacity-40">Anterior</button>
        <span data-search-target="pageLabel" class="text-sm">Página 1</span>
        <button type="button" data-search-target="next" data-action="search#nextPage" disabled class="px-3 py-2 bg-slate-700 rounded disabled:opacity-40">Siguiente</button>
      </nav>
    </section>

    <section class="col-span-4 bg-slate-850 flex flex-col overflow-hidden border-r border-slate-700">
      <div class="px-4 py-3 border-b border-slate-700 flex items-center justify-between">
        <h2 class="font-semibold">Carrito</h2>
        <button data-action="click->cart#clear"
                class="text-xs text-red-400 hover:text-red-300">Vaciar</button>
      </div>

      <div data-cart-target="items" class="flex-1 overflow-y-auto p-3 space-y-2">
        <div class="text-center text-slate-500 py-8" data-cart-target="emptyMessage">
          Carrito vacio
        </div>
      </div>
    </section>

    <section class="col-span-3 bg-slate-800 flex flex-col overflow-hidden">
      <div class="p-4 flex-1 space-y-3">

        <div>
          <label class="block text-xs text-slate-400 mb-1">Cliente (opcional)</label>
          <select data-cart-target="customerSelect"
                  data-action="change->cart#customerChanged"
                  class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded text-sm">
            <option value="">Publico general</option>
            <% Customer.kept.active.ordered.each do |c| %>
              <option value="<%= c.id %>" data-credit-limit="<%= c.credit_limit %>" data-credit-balance="<%= c.credit_balance %>">
                <%= c.name %><%= c.credit_limit.positive? ? " (cupo $#{c.available_credit.to_i})" : "" %>
              </option>
            <% end %>
          </select>
        </div>

        <div class="pt-3 border-t border-slate-700 space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-slate-400">Subtotal</span>
            <span data-cart-target="subtotal">$ 0</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-400">IVA</span>
            <span data-cart-target="taxTotal">$ 0</span>
          </div>
          <div class="flex justify-between text-2xl font-bold pt-2 border-t border-slate-700">
            <span>Total</span>
            <span data-cart-target="total">$ 0</span>
          </div>
        </div>

        <div class="pt-3">
          <label class="block text-xs text-slate-400 mb-1">Metodo de pago</label>
          <div class="grid grid-cols-2 gap-2">
            <button data-action="click->cart#setPaymentMethod"
                    data-method="cash"
                    data-cart-target="paymentCash"
                    class="py-2 bg-emerald-600 hover:bg-emerald-700 rounded text-sm font-medium">
              Efectivo
            </button>
            <button data-action="click->cart#setPaymentMethod"
                    data-method="credit"
                    data-cart-target="paymentCredit"
                    class="py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed"
                    disabled>
              Credito
            </button>
          </div>
        </div>

        <div data-cart-target="errorBox" class="hidden bg-red-900/50 border border-red-700 rounded p-2 text-xs text-red-200"></div>
      </div>

      <div class="p-4 border-t border-slate-700 space-y-2">
        <button data-action="click->cart#suspend"
                class="w-full py-3 bg-amber-600 hover:bg-amber-700 rounded-lg text-sm font-bold">
          Suspender venta
        </button>
        <label class="flex items-center gap-2 px-1 py-2 text-sm text-slate-300">
          <input type="checkbox"
                 data-cart-target="printTicket"
                 class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-emerald-600 focus:ring-emerald-500">
          <span>Imprimir ticket</span>
        </label>
        <button data-action="click->cart#checkout"
                data-cart-target="checkoutButton"
                disabled
                class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 rounded-lg text-lg font-bold disabled:opacity-40 disabled:cursor-not-allowed">
          Cobrar
        </button>
      </div>
    </section>
  </div>
</div>

<%= csrf_meta_tags %>
