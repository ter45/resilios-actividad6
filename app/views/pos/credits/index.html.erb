<div class="min-h-screen bg-slate-900 text-white">
  <header class="bg-slate-800 px-6 py-3 flex items-center justify-between border-b border-slate-700">
    <div class="flex items-center gap-4">
      <h1 class="text-lg font-bold">Cobrar abonos</h1>
      <span class="text-xs px-2 py-1 bg-emerald-700 rounded">Terminal <%= current_user.terminal_assigned || "A" %></span>
      <span class="text-xs text-slate-400"><%= current_user.display_name %></span>
    </div>
    <%= link_to "← Volver al POS", new_pos_sale_path, class: "text-sm text-slate-300 hover:text-white" %>
  </header>

  <main class="max-w-5xl mx-auto p-8 space-y-6">
    <%= form_with url: pos_credits_path, method: :get, local: true, class: "flex gap-3" do %>
      <%= text_field_tag :q, params[:q],
            placeholder: "Buscar cliente por nombre, documento o teléfono...",
            class: "flex-1 px-4 py-3 bg-slate-800 border border-slate-600 rounded-lg text-base focus:ring-2 focus:ring-emerald-500 outline-none",
            autofocus: true %>
      <%= submit_tag "Buscar", class: "px-6 py-3 bg-emerald-600 hover:bg-emerald-700 rounded-lg font-medium cursor-pointer" %>
      <% if params[:q].present? %>
        <%= link_to "Limpiar", pos_credits_path, class: "px-6 py-3 bg-slate-700 hover:bg-slate-600 rounded-lg font-medium" %>
      <% end %>
    <% end %>

    <% if @credits.any? %>
      <div class="space-y-3">
        <% @credits.each do |credit| %>
          <%= link_to pos_credit_path(credit), class: "block bg-slate-800 hover:bg-slate-700 rounded-lg p-4 transition" do %>
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <h3 class="text-lg font-semibold"><%= credit.customer.name %></h3>
                <p class="text-sm text-slate-400">
                  <%= credit.customer.display_document %> · <%= credit.customer.phone.presence || "Sin teléfono" %>
                </p>
                <p class="text-xs text-slate-500 mt-1">
                  Venta <%= credit.sale.number %> · <%= credit.created_at.strftime("%d/%m %H:%M") %>
                </p>
              </div>
              <div class="text-right">
                <p class="text-xs text-slate-400 uppercase">Saldo pendiente</p>
                <p class="text-2xl font-bold text-orange-400"><%= credit.display_balance %></p>
                <p class="text-xs text-slate-500">de <%= credit.display_amount %></p>
              </div>
            </div>
            <div class="mt-3">
              <div class="w-full bg-slate-700 rounded-full h-1.5">
                <div class="bg-emerald-500 h-1.5 rounded-full" style="width: <%= credit.paid_percent %>%"></div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="bg-slate-800 rounded-lg p-12 text-center text-slate-500">
        <% if params[:q].present? %>
          <p>No hay créditos pendientes para "<%= params[:q] %>"</p>
        <% else %>
          <p>No hay créditos pendientes.</p>
        <% end %>
      </div>
    <% end %>
  </main>
</div>

<%= csrf_meta_tags %>
